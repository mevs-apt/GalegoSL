name: Build APK

on:
  workflow_dispatch:
    inputs:
      ref:
        description: "Tag ou branch do SimpMusic (deixe vazio para a principal)"
        required: false
        default: ""

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
          ref: ${{ inputs.ref }}

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - uses: android-actions/setup-android@v3

      - uses: gradle/actions/setup-gradle@v4

      - name: Permissao do gradlew
        run: chmod +x gradlew

      - name: Compilar APK (FOSS, assinado com chave debug)
        run: ./gradlew :androidApp:assembleDebug -PisFullBuild=false --no-daemon --stacktrace

      - uses: actions/upload-artifact@v4
        with:
          name: SimpMusic-APK
          path: androidApp/build/outputs/apk/**/*.apk
